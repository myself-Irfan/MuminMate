# uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# true only locally
DJANGO_DEBUG=false
# comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# how users reach the site, scheme://host[:port] without a trailing slash; mail links start here
DJANGO_PUBLIC_URL=http://localhost:8000

POSTGRES_DB=muminmate
POSTGRES_USER=muminmate
POSTGRES_PASSWORD=
# localhost when Django runs on the host
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# seconds to wait for a db connection; below the readiness probe timeout
POSTGRES_POOL_TIMEOUT_SECONDS=5

# localhost when Django runs on the host
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=muminmate
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=muminmate

# true only when served over HTTPS
DJANGO_HTTPS=false
# 0 locally; start production at 3600, raise to 31536000 once verified
DJANGO_HSTS_SECONDS=0

# log out after this long without a request
DJANGO_SESSION_IDLE_MINUTES=180
# log out this long after login, even if active; at least the idle value
DJANGO_SESSION_ABSOLUTE_HOURS=12
# password reset and email verification links expire after this long
DJANGO_PASSWORD_RESET_TIMEOUT_HOURS=72

# console locally, json in production; one-line JSON (see README).
DJANGO_LOGGING={"level":"INFO","format":"console"}

# Failed-login limits: email+IP, IP, email (then backoff). One-line JSON; see README.
DJANGO_LOGIN_LIMITS={"email_ip":{"max_failures":5,"window_seconds":900},"ip":{"max_failures":100,"window_seconds":900},"email":{"max_failures":20,"window_seconds":3600,"backoff_seconds":60}}

# Mailpit locally (inbox http://127.0.0.1:8025); production: use_tls true, usually port 587. One-line JSON; see README.
DJANGO_EMAIL={"host":"localhost","port":1025,"use_tls":false,"timeout_seconds":10,"default_from_email":"MuminMate <no-reply@localhost>"}
# both empty when the server needs no login (Mailpit), else both set
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
